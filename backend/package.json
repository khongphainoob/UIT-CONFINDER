{
  "name": "uit-confinder-backend",
  "private": true,
  "description": "Backend Express cho UIT ConFinder: catalog từ SQLite, gợi ý hội nghị bằng AI, giới hạn tần suất theo IP",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "ingest": "node --env-file-if-exists=.env scripts/ingest.js",
    "crawl": "node --env-file-if-exists=.env scripts/crawl-cfp.js",
    "enrich": "node --env-file-if-exists=.env scripts/enrich.js",
    "spam-test": "node tools/spam-test.js"
  },
  "dependencies": {
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0"
  }
}
