# Chép file này thành backend/.env rồi điền giá trị. KHÔNG commit file .env.

# Cổng chạy server trên máy. Render tự đặt PORT, không cần khai báo ở đó.
PORT=3000

# Các domain frontend được phép gọi API, cách nhau bằng dấu phẩy.
# Trên máy: trang chạy bằng `python tools/serve.py` hoặc Live Server.
# Trên Render: thêm domain GitHub Pages của nhóm, ví dụ https://<tai-khoan>.github.io
ALLOWED_ORIGIN=http://127.0.0.1:5500,http://localhost:5500

# Số proxy đứng trước server. Render cần 1. Chạy trên máy không qua proxy thì để 0.
TRUST_PROXY=0

# Bật route /api/debug/ip để kiểm tra server đọc đúng IP người dùng sau khi deploy. Kiểm tra xong thì tắt.
DEBUG_IP=0

# Khóa Gemini lấy ở Google AI Studio. Để trống thì /api/match trả 503.
GEMINI_API_KEY=
# Tên model dòng Flash đang có trong gói miễn phí, xem trang Google AI Studio.
GEMINI_MODEL=
